APP_NAME=Motly API
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/motly

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4.1-mini

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Persistent quiz generation (run the quiz-worker service)
QUIZ_MAX_QUESTIONS=15
QUIZ_CONTEXT_CHARS=24000
QUIZ_GENERATION_TIMEOUT_SECONDS=90
QUIZ_GENERATION_MAX_ATTEMPTS=2
QUIZ_WORKER_POLL_SECONDS=2
